DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Optional: set this if FFmpeg is not available on your system PATH.
# FFMPEG_EXECUTABLE_PATH=/usr/bin/ffmpeg

# Optional: maximum song duration, in seconds, that will be downloaded into the cache.
# Longer songs can still be streamed.
MAX_SONG_DURATION_SECONDS=1800

# Optional: hard limit for the song cache, in GB. When full, uncached songs are streamed.
# A warning is logged when less than 1 GB remains.
CACHE_MAX_SIZE_GB=30

# Optional: prevent new song downloads while still reusing files already in song_cache/.
# You can also start the bot with --no-cache.
# DISABLE_SONG_CACHE=false

# Optional: override runtime data locations.
# DATABASE_FILE_PATH=database/music_log.db
# LOG_FILE_PATH=logs/music_bot.log

# Optional: EBU R128 loudness normalization for new downloads (two-pass) and streams (single-pass).
# LOUDNORM_ENABLED=true
# LOUDNORM_TARGET_LUFS=-14.0
# LOUDNORM_TRUE_PEAK=-1.5
# LOUDNORM_LRA=11.0
# CACHE_OPUS_BITRATE=128k
